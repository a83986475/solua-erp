{
  "name": "WhatsApp Conversation",
  "module": "WhatsApp Inbox",
  "doctype": "DocType",
  "engine": "InnoDB",
  "track_changes": 1,
  "fields": [
    {"fieldname": "wa_id", "fieldtype": "Data", "label": "WhatsApp ID", "reqd": 1, "unique": 1, "in_list_view": 1},
    {"fieldname": "display_name", "fieldtype": "Data", "label": "客户名称", "in_list_view": 1},
    {"fieldname": "customer", "fieldtype": "Link", "label": "ERPNext 客户", "options": "Customer", "in_list_view": 1},
    {"fieldname": "status", "fieldtype": "Select", "label": "状态", "options": "未分配\n处理中\n等待客户\n已完成", "default": "未分配", "in_list_view": 1},
    {"fieldname": "assigned_to", "fieldtype": "Link", "label": "负责人", "options": "User", "in_list_view": 1},
    {"fieldname": "priority", "fieldtype": "Select", "label": "优先级", "options": "低\n普通\n高\n紧急", "default": "普通", "in_list_view": 1},
    {"fieldname": "last_message_preview", "fieldtype": "Small Text", "label": "最后消息摘要", "read_only": 1},
    {"fieldname": "unread_count", "fieldtype": "Int", "label": "未读数量", "default": 0, "read_only": 1},
    {"fieldname": "last_inbound_at", "fieldtype": "Datetime", "label": "最后客户消息", "read_only": 1},
    {"fieldname": "last_message_at", "fieldtype": "Datetime", "label": "最后消息", "read_only": 1},
    {"fieldname": "service_window_until", "fieldtype": "Datetime", "label": "客服窗口截止", "read_only": 1},
    {"fieldname": "next_reminder_at", "fieldtype": "Datetime", "label": "下次提醒", "read_only": 1},
    {"fieldname": "reminder_notified_at", "fieldtype": "Datetime", "label": "提醒已通知", "read_only": 1},
    {"fieldname": "reminder_note", "fieldtype": "Small Text", "label": "提醒内容"}
  ],
  "permissions": [
    {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1}
  ],
  "search_fields": "wa_id,display_name,customer,assigned_to",
  "sort_field": "last_message_at",
  "sort_order": "DESC",
  "title_field": "display_name"
}
