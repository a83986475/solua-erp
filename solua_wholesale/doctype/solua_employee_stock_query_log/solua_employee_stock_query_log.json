{
  "name": "Solua Employee Stock Query Log",
  "module": "Solua Wholesale",
  "doctype": "DocType",
  "engine": "InnoDB",
  "autoname": "hash",
  "allow_rename": 0,
  "fields": [
    {"fieldname": "query_time", "fieldtype": "Datetime", "label": "查询时间", "reqd": 1, "index": 1},
    {"fieldname": "user", "fieldtype": "Link", "label": "用户", "options": "User", "reqd": 1, "index": 1},
    {"fieldname": "user_full_name", "fieldtype": "Data", "label": "姓名", "read_only": 1},
    {"fieldname": "query_value", "fieldtype": "Data", "label": "查询值", "reqd": 1, "index": 1},
    {"fieldname": "status", "fieldtype": "Select", "label": "状态", "options": "ok\nno_data\nno_permission\nerror", "reqd": 1, "index": 1},
    {"fieldname": "result_count", "fieldtype": "Int", "label": "结果数量", "read_only": 1},
    {"fieldname": "result_summary", "fieldtype": "Long Text", "label": "结果快照", "read_only": 1},
    {"fieldname": "ip_address", "fieldtype": "Data", "label": "IP 地址", "read_only": 1},
    {"fieldname": "user_agent", "fieldtype": "Small Text", "label": "浏览器信息", "read_only": 1}
  ],
  "permissions": [
    {"role": "System Manager", "read": 1, "export": 1, "print": 1},
    {"role": "Administrator", "read": 1, "export": 1, "print": 1}
  ],
  "sort_field": "query_time",
  "sort_order": "DESC"
}
