--- /etc/nginx/conf.d/erp-ssl.conf
+++ /etc/nginx/conf.d/erp-ssl.conf
@@
+    location ^~ /files/ {
+        try_files /erp.solua.one/public$uri =404;
+        add_header Cache-Control "no-cache, must-revalidate, max-age=0" always;
+    }
+
