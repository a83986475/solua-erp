--- /etc/nginx/conf.d/erp-ssl.conf
+++ /etc/nginx/conf.d/erp-ssl.conf
@@
     location = / {
         # Native report exports POST to /; redirect only page visits.
         set $solua_root_request "$host:$request_method";
         if ($solua_root_request ~ ^erp[.]solua[.]one:(GET|HEAD)$) { return 302 /app; }
-        try_files /erp.solua.one/public/$uri @webserver;
+        proxy_http_version 1.1;
+        proxy_set_header X-Forwarded-For $remote_addr;
+        proxy_set_header X-Forwarded-Proto $scheme;
+        proxy_set_header X-Frappe-Site-Name erp.solua.one;
+        proxy_set_header Host $host;
+        proxy_set_header X-Use-X-Accel-Redirect True;
+        proxy_read_timeout 120;
+        proxy_redirect off;
+        proxy_pass http://frappe-bench-frappe;
     }
@@
     location / {
+        if ($request_method ~ ^(GET|HEAD)$) {
             rewrite ^(.+)/$ $1 permanent;
             rewrite ^(.+)/index\.html$ $1 permanent;
             rewrite ^(.+)\.html$ $1 permanent;
+        }
@@
-        try_files /erp.solua.one/public/$uri @webserver;
+        proxy_http_version 1.1;
+        proxy_set_header X-Forwarded-For $remote_addr;
+        proxy_set_header X-Forwarded-Proto $scheme;
